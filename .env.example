# ========================================
# คัดลอกไฟล์นี้แล้วตั้งชื่อว่า  .env
# cp .env.example .env
# แล้วใส่ค่าของจริงลงไป
# ========================================

# Groq API Key — สมัครฟรีได้ที่ https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────
# Tiny Vision Feature Flag
# ─────────────────────────────────────────────────────────
# false (default): ใช้ pipeline เดิม Image → Groq Vision
# true:            ใช้ Tiny Classifier → JSON → Groq NLP
#                  (Groq ไม่รับภาพ, ประหยัด token, เร็วขึ้น)
#
# Rollback: เปลี่ยนเป็น false ได้ทันทีโดยไม่ต้อง redeploy code
USE_TINY_VISION=false

# Confidence threshold สำหรับ Tiny Vision
# ถ้า classifier confidence < threshold → ไม่ส่งผลไป Groq
# แนะนำ 0.60 (ปรับต่ำถ้าต้องการ recall สูง, สูงถ้าต้องการ precision)
VISION_CONFIDENCE_THRESHOLD=0.60

# ขนาด image สูงสุดสำหรับ Tiny Vision pipeline (MB)
# pipeline เดิมใช้ 20MB (Groq limit), pipeline ใหม่ default 10MB
MAX_IMAGE_SIZE_MB=10
